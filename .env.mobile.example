# Build do app Android/iOS (npm run build:mobile). Copie para .env.mobile (fora do git).
# Só as variáveis que começam com VITE_ entram no app, e elas ficam visíveis dentro dele:
# nada de segredo aqui.

# Servidor do jogo, com https (o app roda em https://localhost e capacitor://localhost e não
# fala com http). É também o endereço que vai nos links de convite.
# No servidor, ponha ALLOWED_ORIGINS=capacitor://localhost,https://localhost
VITE_SERVER_URL=https://8maluco.onrender.com
