{
  "name": "oito-maluco",
  "version": "0.1.0",
  "description": "8 Maluco — jogo de cartas multiplayer online",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch-path=server --watch-path=shared server/index.js",
    "build": "vite build",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "typecheck": "tsc && tsc -p client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
