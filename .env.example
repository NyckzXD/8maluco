# Copie este arquivo para .env (que fica fora do git) e preencha o que for usar.
# O servidor lê o .env ao iniciar; depois de mudar, reinicie o npm run dev.
# Variável definida no terminal ou no painel da plataforma vale mais que o arquivo.
# Todas as opções estão no README, em "Publicando".

# "Entrar com o Google": o ID do cliente OAuth (termina em .apps.googleusercontent.com).
# Vazio, o botão do Google não aparece. Passo a passo no README, em "Login com o Google".
GOOGLE_CLIENT_ID=

# PORT=3000
# DATABASE_FILE=data/oito-maluco.db
# SNAPSHOT_FILE=data/rooms.json
# ALLOWED_ORIGINS=
